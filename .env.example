# ============================================================
# Salesforce credentials (required for every run)
# ============================================================
SF_USERNAME=your.name@example.com
SF_PASSWORD=your_password
SF_SECURITY_TOKEN=your_security_token

# https://login.salesforce.com    — production orgs
# https://test.salesforce.com    — sandbox orgs
SF_LOGIN_URL=https://login.salesforce.com

# ============================================================
# PostgreSQL credentials (required for --dryRun=false)
# ============================================================
PGHOST=localhost              # or Heroku host, Docker IP, etc.
PGPORT=5432
PGDATABASE=postgres-db
PGUSER=postgres
PGPASSWORD=your_password
